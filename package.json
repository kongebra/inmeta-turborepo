{
  "name": "inmeta-turborepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.2.4",
    "turbo": "latest"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.0"
  }
}
